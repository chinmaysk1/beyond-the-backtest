//@version=6
// @description Trade EMA crossovers only when ADX says a trend is present, on this timeframe and on one three times longer.
// @style trend
// @timeframes 4h, 1h, 1d
strategy("EMA cross, trend-filtered", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     process_orders_on_close=true)

fast        = input.int(20, "Fast EMA length", minval=1)
slow        = input.int(62, "Slow EMA length", minval=1)
adx_len     = input.int(9, "ADX length", minval=1)
adx_min     = input.float(23, "Minimum trend strength (longer timeframe)", minval=0, maxval=100)
adx_min_ltf = input.float(28, "Minimum trend strength (this timeframe)", minval=0, maxval=100)
stop_pct    = input.float(4.1, "Stop loss %", minval=0)
// @grid fast     = 10, 20, 30
// @grid slow     = 50, 62, 100
// @grid adx_min  = 18, 23, 28
// @grid stop_pct = 0, 3, 5
// @constraint fast < slow

fast_ema = ta.ema(close, fast)
slow_ema = ta.ema(close, slow)
x_up = ta.crossover(fast_ema, slow_ema)
x_dn = ta.crossunder(fast_ema, slow_ema)

f_adx() =>
    [plus, minus, adx] = ta.dmi(adx_len, adx_len)
    adx
adx_ltf = f_adx()
// Three times this chart's timeframe (4h -> 12h, 1d -> 3D), as the value
// known when each bar closes.
htf = str.tostring(timeframe.multiplier * 3) + (timeframe.isintraday ? "" : timeframe.isweekly ? "W" : timeframe.ismonthly ? "M" : "D")
adx_htf = request.security(syminfo.tickerid, htf, f_adx(), lookahead=barmerge.lookahead_off)
// A missing reading (still warming up) must not block every entry.
trend_ok = (na(adx_htf) or adx_htf >= adx_min) and (na(adx_ltf) or adx_ltf >= adx_min_ltf)

// ADX gates entries only: an open position always exits on the opposite cross.
if strategy.position_size > 0 and x_dn
    strategy.close("Long")
if strategy.position_size < 0 and x_up
    strategy.close("Short")
if x_up and trend_ok
    strategy.entry("Long", strategy.long)
    if stop_pct > 0
        strategy.exit("Long stop", "Long", stop=close * (1 - stop_pct / 100))
if x_dn and trend_ok
    strategy.entry("Short", strategy.short)
    if stop_pct > 0
        strategy.exit("Short stop", "Short", stop=close * (1 + stop_pct / 100))
// Re-issued every bar so the stop always covers the whole position.
if strategy.position_size > 0 and stop_pct > 0
    strategy.exit("Long stop", "Long", stop=strategy.position_avg_price * (1 - stop_pct / 100))
if strategy.position_size < 0 and stop_pct > 0
    strategy.exit("Short stop", "Short", stop=strategy.position_avg_price * (1 + stop_pct / 100))
